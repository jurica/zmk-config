if SHIELD_CHOCOFI_LEFT

config ZMK_KEYBOARD_NAME
	default "chocofi"

config ZMK_SPLIT_ROLE_CENTRAL
	default y

endif

if SHIELD_CHOCOFI_DONGLE

# Max 16 characters in keyboard name
config ZMK_KEYBOARD_NAME
	default "Chocofi Dongle"

config ZMK_SPLIT_ROLE_CENTRAL
	default y

config ZMK_SPLIT
	default y

# The dongle connects to the left and right halves
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
	default 2

# ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS + number of BT profiles (default is 5)
config BT_MAX_CONN
	default 7

# Set this to the same number as BT_MAX_CONN
config BT_MAX_PAIRED
	default 7

endif

if SHIELD_CHOCOFI_LEFT || SHIELD_CHOCOFI_RIGHT

config ZMK_SPLIT
	default y

endif
